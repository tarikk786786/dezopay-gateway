# ========================
# DEZOPAY - .gitignore
# ========================

# --- SECRETS & CREDENTIALS ---
.env
*.env.local
*.env.production
*.env.staging

# --- PHP Dependencies ---
/vendor/
composer.lock

# --- Logs ---
/logs/
*.log
error_log

# --- Database dumps ---
# Note: schema/ directory IS tracked for Firebase Studio setup
*.sql.gz

# --- OS Files ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE / Editor ---
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# --- Keep shared VS Code config ---
# .vscode/ is tracked for Firebase Studio compatibility
# But ignore personal user state files
.vscode/*.code-workspace
.vscode/.ropeproject
.vscode/launch.json

# --- ZIP / Archives ---
*.zip
*.tar.gz
*.rar

# --- Uploads & QR codes ---
/auth/uploads/
/auth/qrcodes/
/secret/Qrcode/

# --- User config ---
.user.ini

# --- Node (if any) ---
node_modules/

# --- Firebase Studio state ---
.idx/.data/

.vercel
